{
  "expo": {
    "name": "FitDoing",
    "slug": "fitdoing",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitdoing",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F4F6",
    "ios": {
      "bundleIdentifier": "com.fitdoing.app"
    },
    "android": {
      "package": "com.fitdoing.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#191919",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "../modules/lock-engine/plugin",
      [
        "expo-camera",
        {
          "cameraPermission": "끼니 사진과 바코드를 찍을 때 카메라를 써요. 사진은 폰에만 저장돼요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": { "backgroundColor": "#191919", "image": "./assets/splash-icon-dark.png" }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#191F28"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "헬스장 위치를 정하고 도착을 확인할 때 위치를 써요. 위치는 폰에만 저장돼요."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
