# 앱이 붙을 서버 주소. 복사해서 app/.env 로 쓴다(.env 는 git 에 안 올라간다).
# 값이 없으면 안드로이드 에뮬레이터 기본값 http://10.0.2.2:8080 을 쓴다.
#
# - 안드로이드 에뮬레이터: 10.0.2.2 가 호스트 PC 의 localhost 다.
# - 실기기: PC 의 LAN IP (같은 와이파이). WSL2 라면 Windows 쪽 IP 이고, 포트 포워딩이 필요할 수 있다
#   (scripts/dev-all.sh 가 안내를 출력한다).
# - 로그인은 서버가 켜져 있어야 한다. 로그인한 뒤에는 서버가 꺼져 있어도 앱은 동작하고,
#   기록은 폰에 쌓였다가 서버가 켜지면 올라간다.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# ---- 로그인 (카카오 · 구글 · 애플) ----
# 로그인은 필수다. 각 서비스의 SDK로 로그인한 토큰을 서버가 확인하고, 기록 백업은 이 계정 단위로 쌓인다.
# 네이티브 모듈이라 값을 바꾸면 개발 빌드를 다시 만들어야 한다(npx expo prebuild / android:dev).
#
# 카카오 네이티브 앱 키. 카카오 개발자 콘솔 > 앱 > 플랫폼 > Android 에 패키지명 com.fitdoing.app 과
# 키 해시(디버그·릴리스 각각)를 등록하고, 카카오 로그인을 켠다. 값이 없으면 카카오 설정 없이 빌드된다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 구글 "웹 애플리케이션" OAuth 클라이언트 ID (xxx.apps.googleusercontent.com). 서버가 ID 토큰을 검증할 때 쓰는 값과 같아야 한다.
# 같은 Google Cloud 프로젝트에 "Android" OAuth 클라이언트도 만들어 패키지명 com.fitdoing.app 과
# 서명 인증서 SHA-1(디버그 키스토어·Play 앱 서명 키 각각)을 등록해야 로그인이 된다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 애플 로그인은 iOS 에서만 보인다. 값은 필요 없고, Apple Developer 에서 번들 ID com.fitdoing.app 에
# Sign in with Apple 기능을 켜면 된다.

# 개발용: 1이면 로그인 없이 시작한다. 서버도 AUTH_DISABLED=1 로 띄워야 한다. 릴리스 빌드에는 쓰지 않는다.
EXPO_PUBLIC_AUTH_DISABLED=
